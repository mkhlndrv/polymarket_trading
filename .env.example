# Copy to .env (gitignored). Only the live tools read these; research runs need none of them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
COLLECTOR_S3_BUCKET=            # collector snapshots (optional)
COLLECTOR_S3_PREFIX=collector
COLLECTOR_CITIES=               # comma-separated city names, empty = all
COLLECTOR_ALERT_WEBHOOK=        # POSTed to after three consecutive task failures (optional)
PAPER_S3_BUCKET=                # paper trader snapshots (optional)
PAPER_S3_PREFIX=paper
